# Copy this file to .env.local and fill in your values.

# MongoDB connection string.
# Local (no install needed): run `npm run db` in a second terminal, then use:
MONGODB_URI=mongodb://127.0.0.1:27027/kilele_hr?replicaSet=kilele
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kilele_hr?retryWrites=true&w=majority

# Random string, at least 32 characters (signs login session cookies).
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# AES-256 key that encrypts PII (National ID, KRA PIN, bank account...) at rest,
# and the key for the National ID blind index. 32+ random characters each.
# If unset, keys are derived from SESSION_SECRET (fine for local dev only).
# WARNING: changing them later makes existing encrypted fields unreadable.
PII_KEY=
PII_INDEX_KEY=

# Demo mode: shows one-click demo accounts on the login page. Turn off in production.
DEMO_MODE=true
# Password given to every seeded demo account by `npm run seed`.
DEMO_PASSWORD=
